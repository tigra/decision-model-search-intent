# Copy to .env (git-ignored) and fill in what you need. Every sidm command reads it;
# variables already set in the environment take precedence.

# TypeSafe's hosted Jev (backend `jev`; paid API)
TYPESAFE_API_KEY=
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# TYPESAFE_DEFAULT_MODEL=jev-latest

# OpenAI's Decisions API (backend `openai`; paid, needs credits on the account)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com

# Local servers, if not on the default ports
# OLLAMA_HOST_URL=http://localhost:11434
# SIDM_MLX_URL=http://localhost:11500
# SIDM_OLLAYA_URL=http://localhost:11435
# SIDM_DECIDER_URL=http://localhost:11600
